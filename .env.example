# ──────────────────────────────────────────────────────────────
# System Breach — Referência de variáveis de ambiente
#
# Este arquivo é apenas documentação — o servidor NÃO carrega
# arquivos .env automaticamente.
#
# Como definir as variáveis:
#   • Com PM2 (produção): edite env{} em ecosystem.config.js
#   • Direto (desenvolvimento): export PORT=3000 && node server.js
#                          OU: PORT=3000 node server.js
# ──────────────────────────────────────────────────────────────

# Porta TCP em que o servidor HTTP + WebSocket vai escutar.
# Obrigatória — o servidor não inicia sem ela.
PORT=3000

# Segredo usado para assinar tokens JWT.
# TROQUE este valor em produção — qualquer string longa e aleatória serve.
# Exemplo: openssl rand -hex 32
JWT_SECRET=systembreach_jwt_secret_change_me_2024
